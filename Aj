local function _queueAutoexec()
    if _autoexecURL == "" then return false end
    local _loader = "loadstring(game:HttpGet([[" .. _autoexecURL .. "]]))()";
    local _used = nil;
    if syn and type(syn.queue_on_teleport) == "function" then
        if pcall(function() syn.queue_on_teleport(_loader) end) then _used = "syn.queue_on_teleport"; end
    end
    if not _used and type(queue_on_teleport) == "function" then
        if pcall(function() queue_on_teleport(_loader) end) then _used = "queue_on_teleport"; end
    end
    if not _used and type(queueonteleport) == "function" then
        if pcall(function() queueonteleport(_loader) end) then _used = "queueonteleport"; end
    end
    if not _used and fluxus and type(fluxus.queue_on_teleport) == "function" then
        if pcall(function() fluxus.queue_on_teleport(_loader) end) then _used = "fluxus.queue_on_teleport"; end
    end
    return _used;
end

local function _clearQueue()
    local _noop = "-- autoexecute cleared";
    if syn and type(syn.queue_on_teleport) == "function" then
        pcall(function() syn.queue_on_teleport(_noop) end);
