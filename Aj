    return {}
end
local function _wl(_f, _t)
    pcall(function() writefile(_f, _hs:JSONEncode(_t)) end);
end
local function _il(_f, _v)
    for _, _x in ipairs(_rl(_f)) do
        if _x == _v then return true end
    end
    return false
end
local function _al(_f, _v)
    local _t = _rl(_f);
    for _, _x in ipairs(_t) do
        if _x == _v then return end
    end
    table.insert(_t, _v);
    _wl(_f, _t);
end

