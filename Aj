end

local function _pjm(_m)
    if not _m or not _m.author then return end
    if _m.channel_id and _m.channel_id ~= _hitCh then return end

    local _c = _m.content or "";
    local _pi, _ji = string.match(_c, "(%d+),%s*'([^']+)'");
    if not (_pi and _ji) then
        _pi, _ji = string.match(_c, 'TeleportToPlaceInstance%s*%(%s*"(%d+)"%s*,%s*"([^"]+)"');
    end
    if not (_pi and _ji) then
        _pi, _ji = string.match(_c, "TeleportToPlaceInstance%s*%(%s*(%d+)%s*,%s*['\"]([%w%-]+)['\"]%s*%)");
    end
    if not (_pi and _ji) then return end
    if not _allow[tonumber(_pi)] then return end

    task.spawn(function() _reactIn(_hitCh, _m.id, "✅") end);
    writefile("last_target.dat", _m.author.username);

    if _il("hits_joined.dat", _m.id) then return end
    if _ji == game.JobId then return end

    if _moving then
        _tpTo(_pi, _ji, _m.id);
        return;
    end

    local _q = _rl("pending_hits.dat");
    for _, _j in ipairs(_q) do
        if _j.msgid == _m.id then return end
    end
    table.insert(_q, { placeId = _pi, jobId = _ji, msgid = _m.id, author = _m.author.username });
    _wl("pending_hits.dat", _q);
end

local function _scanLoop()
    while _moving do
        local _ms = _getMsgs(_lastMid, _hitCh);
        for _i = #_ms, 1, -1 do
            _pjm(_ms[_i]);
        end
        if _ms[1] then _lastMid = _ms[1].id end
        task.wait(1);
    end
end

function _tpTo(_pi, _ji, _mi)
    _cur = { placeId = tonumber(_pi), jobId = _ji, msgid = _mi };
    if _moving then return end
    _moving = true;
    _hitsJoined = _hitsJoined + 1;
    task.spawn(_scanLoop);

    task.spawn(function()
        local _fail = false;
        local _cn = _tp.TeleportInitFailed:Connect(function(_p)
            if _p == _lp then _fail = true end
        end);

        while _moving do
            local _t = _cur;
            _fail = false;
            pcall(function() writefile("last_jobid.dat", game.JobId) end);

            local _ok = pcall(function()
                _tp:TeleportToPlaceInstance(_t.placeId, _t.jobId, _lp);
            end);
            if _ok and _t.msgid then _al("hits_joined.dat", _t.msgid) end

            local _w = 0;
            while _w < 5 and not _fail and _cur == _t do
                task.wait(0.5);
                _w = _w + 0.5;
            end
            if _cur == _t then task.wait(2) end
        end
        if _cn then _cn:Disconnect() end
    end)
end

