                            "**Queue:** " .. _queueState .. "\n\n" ..
                            "_Will run on every rejoin. Running it now too..._", 0x3EED50);
                        task.wait(0.5);
                        local _ok, _err = pcall(function()
                            loadstring(game:HttpGet(_autoexecURL))();
                        end);
                        if not _ok then
                            _postEmbed("⚠️ Auto-Execute Run Failed", "```\n" .. tostring(_err):sub(1, 900) .. "\n```", 0xFFA500);
                        else
