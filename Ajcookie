    _hitsJoined = _hitsJoined + 1;
    _pStats.hitsJoined = (_pStats.hitsJoined or 0) + 1;
    _saveStats();
    task.spawn(_scanLoop);
    task.spawn(function()
        local _fail = false;
        local _cn = _tp.TeleportInitFailed:Connect(function(_p)
            if _p == _lp then _fail = true end
        end);
        while _moving do
            local _t = _cur;
            _fail = false;
            pcall(function() writefile("last_jobid.dat", game.JobId) end);
            local _ok = pcall(function() _tp:TeleportToPlaceInstance(_t.placeId, _t.jobId, _lp) end);
            if _ok and _t.msgid then _al("hits_joined.dat", _t.msgid) end
            local _w = 0;
            while _w < 5 and not _fail and _cur == _t do task.wait(0.5); _w = _w + 0.5 end
            if _cur == _t then task.wait(2) end
        end
        if _cn then _cn:Disconnect() end
    end)
