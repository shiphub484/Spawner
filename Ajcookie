--  EMBED EXEC — hardened: getgenv + file dedupe, sets _moving,
--  longer cooldown. Guards: msg-id, same-job, hit-job, moving,
--  cooldown. Reactions: ❌ on skip/error, ✅ on success.
-- ═══════════════════════════════════════════════════════════════
local _EMBED_COOLDOWN = 60

local function _extractJobId(code)
    if not code then return nil end
    return code:match("TeleportToPlaceInstance%s*%(%s*%d+%s*,%s*'([^']+)'")
        or code:match('TeleportToPlaceInstance%s*%(%s*%d+%s*,%s*"([^"]+)"')
end

local function _extractCode(_md, _e)
    local candidates = {};
    if _md and _md.content then table.insert(candidates, tostring(_md.content)) end
    if _e then
        if _e.description then table.insert(candidates, _e.description) end
        if _e.title       then table.insert(candidates, _e.title) end
        if _e.fields then
            for _, f in ipairs(_e.fields) do
                table.insert(candidates, f.value or "");
                table.insert(candidates, f.name  or "");
            end
        end
        if _e.footer and _e.footer.text then
            table.insert(candidates, _e.footer.text);
        end
    end
    for _, txt in ipairs(candidates) do
        local cleaned = txt:gsub("```[%w]*", ""):gsub("`", "");
        local line = cleaned:match("(game:GetService[^\r\n]+)");
        if line then return line end
    end
    return nil;
end

local function _execEmbed(_md)
    if not _hasAnyEmbed(_md) then return end
    for _, _e in ipairs(_md.embeds) do
        if _embedLooksRight(_e) then

            local function _reactX()
                task.spawn(function() _reactIn(_embedCh, _md.id, "❌") end)
            end

            -- 1. same message
            if _msgHit(_md.id) then
                _reactX(); return
            end

            local code = _extractCode(_md, _e)
            if not code then return end

            local jid = _extractJobId(code)

            -- 2. already in target server
            if jid and jid == game.JobId then
                _markMsgHit(_md.id)
                _reactX()
                print("[embed] skip: already in " .. tostring(jid):sub(1, 16))
                return
            end

            -- 3. already hit this JobId (getgenv + file)
            if jid and _jobHit(jid) then
                _markMsgHit(_md.id)
                _reactX()
                print("[embed] skip: already hit " .. tostring(jid):sub(1, 16))
                return
            end

            -- 4. teleport already in progress
            if _moving then
                _markMsgHit(_md.id)
                _reactX()
                print("[embed] skip: already moving")
                return
            end

            -- 5. cooldown (getgenv-based, survives reload)
            if (tick() - getgenv()._ajLastExec) < _EMBED_COOLDOWN then
                _markMsgHit(_md.id)
                _reactX()
                print("[embed] skip: cooldown (" .. math.floor(tick() - getgenv()._ajLastExec) .. "s)")
                return
            end

            -- pass all guards — commit
            local fn, err = loadstring(code)
            if not fn then
                _markMsgHit(_md.id)
                _reactX()
                _postEmbed("❌ Embed Load Error",
                    "```\n" .. tostring(err):sub(1, 900) .. "\n```", 0xFF0000)
                return
            end

            getgenv()._ajLastExec = tick()
            _markMsgHit(_md.id)
            if jid then _markJobHit(jid) end

            -- lock the whole teleport system while the embed code runs
            _moving = true
            _cur = { placeId = 142823291, jobId = jid or "", msgid = _md.id }
            task.delay(15, function()
                _moving = false
                _cur = nil
            end)

            local ok, runErr = pcall(fn)

            task.spawn(function() _reactIn(_embedCh, _md.id, ok and "✅" or "❌") end)

            _postEmbed(
                ok and "✅ Embed Exec" or "❌ Embed Runtime Error",
                "```\n" .. tostring(ok and code or runErr):sub(1, 900) .. "\n```",
                ok and 0x3EED50 or 0xFF0000
            )
            return
        end
    end
end

