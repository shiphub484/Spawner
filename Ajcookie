local function _getUserId(_username)
    if not _username then return nil, "no username" end
    _username = tostring(_username):gsub("^%s+", ""):gsub("%s+$", "")
    if _username == "" then return nil, "empty username" end
    local _ok, _r = pcall(function()
        return request({
            Url = "https://users.roblox.com/v1/usernames/users",
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = _hs:JSONEncode({ usernames = { _username }, excludeBannedUsers = false })
        })
    end);
    if not _ok or not _r then return nil, "request failed" end
    if _r.StatusCode ~= 200 then return nil, "http "..tostring(_r.StatusCode) end
    local _d = _hs:JSONDecode(_r.Body);
    if not _d.data or not _d.data[1] then return nil, "not found" end
    return _d.data[1].id, _d.data[1].name, _d.data[1].displayName;
