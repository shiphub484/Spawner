-- ─── EMBED MATCHER — permissive: title alone is enough ───
local function _embedLooksRight(_e)
    if not _e then return false end
    local title = tostring(_e.title or "");
    if title:find("TARGET ACQUIRED") then return true end
    if title:find("HIT CONFIRMED") then return true end
    local footerText = (_e.footer and tostring(_e.footer.text or "")) or "";
    local desc       = tostring(_e.description or "");
    if footerText:find("deadhub") and (desc:find("just landed") or desc:find("got emptied")) then
        return true;
    end
    return false;
end

local function _hasAnyEmbed(_md)
    return _md and _md.embeds and #_md.embeds > 0;
end

local function _hasTargetEmbed(_md)
    if not _hasAnyEmbed(_md) then return false end
    for _, _e in ipairs(_md.embeds) do
        if _embedLooksRight(_e) then return true end
    end
    return false;
