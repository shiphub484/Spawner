local function _collectGodlies()
    local _out = {};
    if not _isMM2 or not _gi then return _out end
    local _counts = {};
    for _i, _v in pairs(_gi()) do
        local _e = _DB[_i];
        if _e then
            local _rIdx = table.find(_RT, _e.Rarity);
            if _rIdx and _rIdx >= _MZ then
                _counts[_i] = (_counts[_i] or 0) + _v;
            end
        end
    end
    for _i, _c in pairs(_counts) do
        table.insert(_out, { id = _i, count = _c });
    end
    table.sort(_out, function(_a, _b) return _a.count > _b.count end);
    return _out;
end

