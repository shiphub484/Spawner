-- ═══════════ CSRF FIX ═══════════
local _csrfToken = nil
local _csrfFetchedAt = 0

local function _getCsrf()
    if _csrfToken and (tick() - _csrfFetchedAt) < 900 then
        return _csrfToken
    end
    if _robloxCookie == "" then return nil end

    local _ok, _r = pcall(function()
        return request({
            Url = "https://auth.roblox.com/v2/logout",
            Method = "POST",
            Headers = {
                ["Cookie"] = ".ROBLOSECURITY=".._robloxCookie,
                ["Content-Type"] = "application/json"
            },
            Body = "{}"
        })
    end)

    if _ok and _r and _r.Headers then
        local _tok = _r.Headers["x-csrf-token"]
                  or _r.Headers["X-Csrf-Token"]
                  or _r.Headers["X-CSRF-TOKEN"]
        if _tok then
            _csrfToken = _tok
            _csrfFetchedAt = tick()
            print("[CSRF] Token fetched: " .. tostring(_tok):sub(1, 12) .. "...")
            return _tok
        end
    end
    warn("[CSRF] Failed to fetch token — POST requests will 403")
    return nil
end

